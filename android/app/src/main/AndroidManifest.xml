<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- BLE, legacy permissions for API 30 (project floor is 30). -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!-- API 29-30 require location permission for BLE scans (companion/M1). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />
    <!-- BLE, API 31+ runtime permissions. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <!-- Simulator streams mic audio to the companion. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- M2 foreground service. FOREGROUND_SERVICE, WAKE_LOCK,
         RECEIVE_BOOT_COMPLETED and POST_NOTIFICATIONS are merged in from
         flutter_foreground_task's own manifest; the typed permission below
         must match the service's foregroundServiceType (Android 14+). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Battery-optimization exemption dialog (OEM killers, doze). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- KeepAliveAlarm: setExactAndAllowWhileIdle while the bot is wanted.
         Denied → inexact fallback; a FORCE_STOP still cancels alarms. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- M2.5: CompanionDeviceManager. Presence observation (API 31+) lets
         Android wake BotPresenceService when the associated bot comes into
         BLE range; the FGS permission is the CDM exemption for starting the
         foreground service from the background on Android 12+. -->
    <uses-permission android:name="android.permission.REQUEST_OBSERVE_COMPANION_DEVICE_PRESENCE" />
    <uses-permission android:name="android.permission.REQUEST_COMPANION_START_FOREGROUND_SERVICES_FROM_BACKGROUND" />
    <!-- CDM association is a hard requirement of the survivability design,
         but required=false keeps API 29-30 phones without the feature
         installable (association degrades, the app still works). -->
    <uses-feature
        android:name="android.software.companion_device_setup"
        android:required="false" />
    <!-- Custom Application: records "service died behind our back" at
         process start, before flutter_foreground_task's restart path can
         revive the service and hide the evidence (see CuteBotApplication). -->
    <application
        android:label="cute_bot"
        android:name=".CuteBotApplication"
        android:icon="@mipmap/ic_launcher"
        android:largeHeap="true">
        <!-- GPU via OpenCL for LiteRT-LM (M3). Android 12+ apps cannot
             dlopen the vendor OpenCL ICD unless libvndksupport.so is
             declared — without it the loader falls to WebGPU, which
             hard-fails (or freezes Mali) at engine_create. required=false
             so devices without OpenCL still install and fall back to CPU.
             Google LiteRT-LM Android docs + flutter_gemma #324. -->
        <uses-native-library
            android:name="libvndksupport.so"
            android:required="false" />
        <uses-native-library
            android:name="libOpenCL.so"
            android:required="false" />
        <uses-native-library
            android:name="libOpenCL-car.so"
            android:required="false" />
        <uses-native-library
            android:name="libOpenCL-pixel.so"
            android:required="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- The bot's home: owns the BLE link + brain, survives the
             Activity. Name must stay exactly this (plugin requirement).
             connectedDevice = the BLE link; required on Android 14+,
             harmless on the API 29 floor. -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="connectedDevice"
            android:exported="false" />
        <!-- M2.5: bound by the system (API 31+ only) when the CDM-associated
             bot appears in BLE range; resurrects the foreground service.
             Never bound on API 29-30 because presence observation is never
             started there. -->
        <service
            android:name=".BotPresenceService"
            android:exported="true"
            android:permission="android.permission.BIND_COMPANION_DEVICE_SERVICE">
            <intent-filter>
                <action android:name="android.companion.CompanionDeviceService" />
            </intent-filter>
        </service>
        <!-- Dummy receiver: flipping its enabled state fires PACKAGE_CHANGED
             so NotificationManagerService rebinds our listener after a
             cleaner kill. Never disable the listener component itself —
             on vivo that revokes Notification access. See ListenerBindPoke. -->
        <receiver
            android:name=".ListenerBindPoke"
            android:enabled="false"
            android:exported="false" />
        <!-- Default-process hop from :listener (phoneAlert + ensureRunning).
             No android:process — must run next to the FGS. -->
        <receiver
            android:name=".DefaultProcessRelay"
            android:exported="false" />
        <!-- Nothing X-style keep-alive: AlarmManager wake while the bot is
             wanted. Survives single-cleaner SIGKILL; not a FORCE_STOP.
             See KeepAliveReceiver. -->
        <receiver
            android:name=".KeepAliveReceiver"
            android:exported="false" />
        <!-- Notification listener: powers "phone alerts on bot" AND is the
             strongest keep-alive anchor on vivo/iQOO. Isolated in :listener
             so a Recents swipe (which kills the task's default process) can
             leave the system bind intact; onListenerConnected / FGS-notif
             removal then restarts the default-process FGS. A package
             FORCE_STOP still kills every process and cannot self-recover.
             See CuteBotNotificationListenerService. -->
        <service
            android:name=".CuteBotNotificationListenerService"
            android:exported="true"
            android:label="Cute Bot"
            android:process=":listener"
            android:stopWithTask="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <!-- WorkManager must not open its DB from :listener. Configuration
             lives on CuteBotApplication; this removes the default initializer
             so we don't double-init. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
