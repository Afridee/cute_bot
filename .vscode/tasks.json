{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "flutter: build apk --release",
            "type": "shell",
            "command": "${config:dart.flutterSdkPath}/bin/flutter",
            "args": [
                "build",
                "apk",
                "--release",
                "--target-platform",
                "android-arm64",
                "--obfuscate",
                "--split-debug-info",
                "build/app/outputs/symbols",
                "--tree-shake-icons",
                "--dart-define-from-file",
                "config.json"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}
